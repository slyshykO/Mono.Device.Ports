include("${CMAKE_CURRENT_LIST_DIR}/FindZig.cmake")
if(NOT ZIG_EXECUTABLE)
    mdp_find_zig()
endif()
if(NOT ZIG_TARGET MATCHES "^(x86_64|aarch64|arm)-linux-(gnu|musl|gnueabihf|musleabihf)(\\.[0-9.]+)?$")
    message(FATAL_ERROR "Set ZIG_TARGET to a Linux target, e.g. x86_64-linux-gnu.2.28 or aarch64-linux-musl.")
endif()
set(CMAKE_SYSTEM_NAME Linux)
string(REGEX REPLACE "-.*$" "" CMAKE_SYSTEM_PROCESSOR "${ZIG_TARGET}")
set(CMAKE_C_COMPILER "${ZIG_EXECUTABLE}" cc -target "${ZIG_TARGET}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ZIG_EXECUTABLE ZIG_TARGET)
