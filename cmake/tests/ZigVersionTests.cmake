cmake_minimum_required(VERSION 3.21)
include("${CMAKE_CURRENT_LIST_DIR}/../FindZig.cmake")
foreach(pair "0.15.10|0.15.9" "0.16.0-dev.100+aaaa|0.16.0-dev.9+ffff" "0.16.0|0.16.0-dev.100" "0.16.0-beta|0.16.0-alpha" "0.16.0-dev.1|0.16.0-dev")
    string(REPLACE "|" ";" versions "${pair}")
    list(GET versions 0 newer)
    list(GET versions 1 older)
    mdp_zig_version_greater("${newer}" "${older}" result)
    if(NOT result)
        message(FATAL_ERROR "Expected ${newer} > ${older}")
    endif()
    mdp_zig_version_greater("${older}" "${newer}" result)
    if(result)
        message(FATAL_ERROR "Unexpected ${older} > ${newer}")
    endif()
endforeach()
mdp_zig_version_greater("0.16.0-dev.100+aaaa" "0.16.0-dev.100+ffff" result)
if(result)
    message(FATAL_ERROR "Build metadata must not change precedence")
endif()
foreach(version "0.17.1" "0.16.0-dev.100+aaaa")
    mdp_valid_zig_version("${version}" valid)
    if(NOT valid)
        message(FATAL_ERROR "Valid version rejected: ${version}")
    endif()
endforeach()
foreach(version "garbage" "0.16" "01.16.0" "0.16.0-dev.01" "0.16.0-")
    mdp_valid_zig_version("${version}" valid)
    if(valid)
        message(FATAL_ERROR "Invalid version accepted: ${version}")
    endif()
endforeach()
message(STATUS "Zig semantic version tests passed")
