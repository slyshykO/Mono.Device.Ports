# Discovery follows orange-iot-thermometer/soft/xtask: an explicit ZIG_BIN,
# otherwise the newest working semantic version across known roots and PATH.
function(mdp_valid_zig_version version result)
    set(valid FALSE)
    if("${version}" MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
        set(valid TRUE)
        set(prerelease "${CMAKE_MATCH_5}")
        string(REPLACE "." ";" identifiers "${prerelease}")
        foreach(identifier IN LISTS identifiers)
            if(identifier MATCHES "^0[0-9]+$")
                set(valid FALSE)
            endif()
        endforeach()
    endif()
    set(${result} "${valid}" PARENT_SCOPE)
endfunction()

function(mdp_zig_version_greater candidate current result)
    # VERSION comparison ignores prereleases; compare their identifiers explicitly.
    set(${result} FALSE PARENT_SCOPE)
    string(REGEX REPLACE "\\+.*$" "" candidate "${candidate}")
    string(REGEX REPLACE "\\+.*$" "" current "${current}")
    if(candidate VERSION_GREATER current)
        set(${result} TRUE PARENT_SCOPE)
        return()
    elseif(candidate VERSION_LESS current)
        return()
    endif()
    string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+" "" a "${candidate}")
    string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+" "" b "${current}")
    if(a STREQUAL "" OR b STREQUAL "")
        if(a STREQUAL "" AND NOT b STREQUAL "")
            set(${result} TRUE PARENT_SCOPE)
        endif()
        return()
    endif()
    string(SUBSTRING "${a}" 1 -1 a)
    string(SUBSTRING "${b}" 1 -1 b)
    string(REPLACE "." ";" a "${a}")
    string(REPLACE "." ";" b "${b}")
    list(LENGTH a a_length)
    list(LENGTH b b_length)
    math(EXPR last "${a_length} - 1")
    foreach(index RANGE ${last})
        if(index GREATER_EQUAL b_length)
            set(${result} TRUE PARENT_SCOPE)
            return()
        endif()
        list(GET a ${index} av)
        list(GET b ${index} bv)
        if(av STREQUAL bv)
            continue()
        endif()
        if(av MATCHES "^[0-9]+$" AND bv MATCHES "^[0-9]+$")
            if(av VERSION_GREATER bv)
                set(${result} TRUE PARENT_SCOPE)
            endif()
        elseif(bv MATCHES "^[0-9]+$" OR (NOT av MATCHES "^[0-9]+$" AND av STRGREATER bv))
            set(${result} TRUE PARENT_SCOPE)
        endif()
        return()
    endforeach()
endfunction()

function(mdp_zig_candidates path depth result)
    set(found)
    if(IS_DIRECTORY "${path}" AND depth GREATER 0)
        if(CMAKE_HOST_WIN32)
            set(executable "${path}/zig.exe")
        else()
            set(executable "${path}/zig")
        endif()
        if(EXISTS "${executable}" AND NOT IS_DIRECTORY "${executable}")
            list(APPEND found "${executable}")
        endif()
        file(GLOB children LIST_DIRECTORIES TRUE "${path}/zig*")
        list(SORT children)
        math(EXPR next_depth "${depth} - 1")
        foreach(child IN LISTS children)
            mdp_zig_candidates("${child}" ${next_depth} nested)
            list(APPEND found ${nested})
        endforeach()
    elseif(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        list(APPEND found "${path}")
    endif()
    set(${result} "${found}" PARENT_SCOPE)
endfunction()

function(mdp_find_zig)
    if(DEFINED ZIG_BIN)
        set(override "${ZIG_BIN}")
        set(explicit TRUE)
    elseif(DEFINED ENV{ZIG_BIN})
        set(override "$ENV{ZIG_BIN}")
        set(explicit TRUE)
    endif()
    set(candidates)
    if(explicit)
        mdp_zig_candidates("${override}" 2 candidates)
    else()
        if(CMAKE_HOST_WIN32 AND DEFINED ENV{USERPROFILE})
            set(roots "$ENV{USERPROFILE}/bin")
        else()
            set(roots "$ENV{HOME}/bin")
        endif()
        if(CMAKE_HOST_WIN32)
            list(APPEND roots "D:/bin" "D:/bin/_compilers")
        endif()
        foreach(root IN LISTS roots)
            mdp_zig_candidates("${root}/zig" 2 found)
            list(APPEND candidates ${found})
            file(GLOB entries LIST_DIRECTORIES TRUE "${root}/zig*")
            list(SORT entries)
            foreach(entry IN LISTS entries)
                mdp_zig_candidates("${entry}" 2 found)
                list(APPEND candidates ${found})
            endforeach()
        endforeach()
        cmake_path(CONVERT "$ENV{PATH}" TO_CMAKE_PATH_LIST search_path NORMALIZE)
        foreach(directory IN LISTS search_path)
            if(CMAKE_HOST_WIN32)
                list(APPEND candidates "${directory}/zig.exe")
            else()
                list(APPEND candidates "${directory}/zig")
            endif()
        endforeach()
    endif()
    list(REMOVE_DUPLICATES candidates)
    set(best "")
    set(best_version "")
    foreach(candidate IN LISTS candidates)
        if(NOT EXISTS "${candidate}" OR IS_DIRECTORY "${candidate}")
            continue()
        endif()
        execute_process(COMMAND "${candidate}" version RESULT_VARIABLE status
            OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 5)
        mdp_valid_zig_version("${version}" valid)
        if(NOT status STREQUAL "0" OR NOT valid)
            continue()
        endif()
        mdp_zig_version_greater("${version}" "${best_version}" newer)
        if(best STREQUAL "" OR newer)
            file(REAL_PATH "${candidate}" best)
            set(best_version "${version}")
        endif()
    endforeach()
    if(best STREQUAL "")
        if(explicit)
            message(FATAL_ERROR "ZIG_BIN does not identify a working Zig executable or directory: ${override}")
        endif()
        message(FATAL_ERROR "Zig not found. Set ZIG_BIN or install it in ~/bin/zig*, D:/bin/zig*, D:/bin/_compilers/zig*, or PATH.")
    endif()
    set(ZIG_EXECUTABLE "${best}" CACHE FILEPATH "Selected Zig executable" FORCE)
    set(ZIG_VERSION "${best_version}" CACHE STRING "Selected Zig version" FORCE)
    message(STATUS "Using Zig ${best_version}: ${best}")
endfunction()
