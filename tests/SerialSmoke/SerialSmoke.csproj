<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SerialPackageVersion Condition="'$(SerialPackageVersion)' == ''">0.1.0</SerialPackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackedLibrary)' != 'true'">
    <ProjectReference Include="../../Mono.Device.Ports/Mono.IO.Ports.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackedLibrary)' == 'true'">
    <PackageReference Include="Mono.IO.Ports" Version="$(SerialPackageVersion)" />
  </ItemGroup>
</Project>
