{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "zig-linux",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/artifacts/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/zig-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/artifacts/native",
        "BUILD_TESTING": "OFF"
      }
    },
    { "name": "linux-x64", "inherits": "zig-linux", "cacheVariables": { "ZIG_TARGET": "x86_64-linux-gnu.2.28", "MDP_RUNTIME_ID": "linux-x64" } },
    { "name": "linux-arm64", "inherits": "zig-linux", "cacheVariables": { "ZIG_TARGET": "aarch64-linux-gnu.2.28", "MDP_RUNTIME_ID": "linux-arm64" } },
    { "name": "linux-musl-x64", "inherits": "zig-linux", "cacheVariables": { "ZIG_TARGET": "x86_64-linux-musl", "MDP_RUNTIME_ID": "linux-musl-x64" } },
    { "name": "linux-musl-arm64", "inherits": "zig-linux", "cacheVariables": { "ZIG_TARGET": "aarch64-linux-musl", "MDP_RUNTIME_ID": "linux-musl-arm64" } },
    { "name": "linux-arm", "inherits": "zig-linux", "cacheVariables": { "ZIG_TARGET": "arm-linux-gnueabihf.2.28", "MDP_RUNTIME_ID": "linux-arm" } },
    { "name": "linux-musl-arm", "inherits": "zig-linux", "cacheVariables": { "ZIG_TARGET": "arm-linux-musleabihf", "MDP_RUNTIME_ID": "linux-musl-arm" } }
  ]
}
